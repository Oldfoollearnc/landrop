{
  "name": "nearsend",
  "productName": "NearSend",
  "version": "2.0.0",
  "description": "近传：手机与电脑在同一 Wi-Fi 下直传文字、图片和文件，不登录、不上云、不压缩",
  "main": "src/main/main.js",
  "author": {
    "name": "NearSend"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node tools/gen-icon.js",
    "icon:android": "node tools/gen-android-icon.js",
    "test": "node tools/test-server.js",
    "test:e2e": "node tools/e2e-mobile.js",
    "dist": "electron-builder --win nsis portable",
    "dist:setup": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.13.3"

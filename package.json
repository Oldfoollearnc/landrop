{
  "name": "nearsend",
  "productName": "NearSend",
  "version": "3.0.0",
  "description": "近传 3.0：局域网远程工位 + 群聊。Windows 控制端直连工位电脑，保留手机扫码群聊、文件传输与团队协作",
  "main": "src/main/main.js",
  "author": {
    "name": "NearSend"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node tools/gen-icon.js",
    "icon:android": "node tools/gen-android-icon.js",
    "build:input": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-remote-input.ps1",
    "test": "node tools/test-server.js",
    "test:e2e": "node tools/e2e-mobile.js",
    "predist": "npm run build:input",
    "predist:setup": "npm run build:input",
    "predist:dir": "npm run build:input",
    "dist": "electron-builder --win nsis portable",
    "dist:setup": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.13.3"
  }
}
